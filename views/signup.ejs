<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <center>
    <a href="/"><img class="h-20 mt-10 justify-center" src="/images/vibha-stree.png" alt="logoooooo" srcset=""></a>
    </center>
    <section class="bg-white form text-center rounded  mt-[10%] lg:ml-[35%] lg:mr-[35%]">
        <form action="/signup" class="loginForm h-fit w-full p-5" method="post">
            <h1 class="text-4xl mb-10 mt-5">Signup to VibhaStree</h1>
            <label class="float-left pl-4" for="fullname">Fullname</label>
            <input class="h-10 w-full lg:w-96 rounded-md border p-2 mb-7 " type="text" name="fullname" placeholder="Enter fullname"><br>
            <label class="float-left pl-4" for="email">Email</label>
            <input class="h-10 w-full lg:w-96 rounded-md border p-2 mb-7 " type="email" name="email" placeholder="Enter email"><br>
            <label class="float-left pl-4" for="password">Password</label>
            <input class="h-10 w-full lg:w-96 rounded-md border p-2 mb-7 " type="password" name="password" placeholder="Enter a strong password"><br>
            <button class="bg-green-700 text-white mt-8 p-2 text-xl  w-full rounded-lg" type="submit">Signup</button>
        </form>
        <p class="pb-5">Already have an account?<a class="font-bold active:no-underline" href="/login"> Signup</a></p>
    </section>
    
</body>
</html>