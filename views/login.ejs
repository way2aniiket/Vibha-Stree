<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <center>
        <a href="/"><img class="h-20 mt-10 justify-center" src="/images/vibha-stree.png" alt="logoooooo" srcset=""></a>
    </center>
    <section class="bg-white form text-center rounded  mt-[10%] lg:ml-[35%] lg:mr-[35%]">
        <form action="/login" class="loginForm h-fit w-full p-5" method="post">
            <h1 class="text-4xl mb-10 smt-5">Login to VibhaStree</h1>
            <label class="float-left pl-4" for="email">Email</label>
            <input class="h-10 w-full lg:w-96 rounded-md border p-2 mb-7 " type="text" name="email" id="email" placeholder="Enter your email"><br>
            <label class="float-left pl-4" for="password">Password</label>
            <input class="h-10 w-full lg:w-96 rounded-md border p-2 mb-7 " type="password" name="password" id="password" placeholder="Please enter you password"><br>
            <a class="pr-4 float-right cursor-pointer" href="/forgotPassword">Forgot password?</a><br>
            <button class="bg-green-700 text-white mt-8 p-2 text-xl  w-full rounded-lg" type="submit">Login to VibhaStree</button>
        </form>
        <p class="pb-5">Already have an account?<a class="font-bold active:no-underline" href="/signup"> Signup</a></p>

    </section>
    
</body>
</html>